+
+// Tensor parallelism for diffusion transformers on the ggml meta backend (backend token "tp").
+// The devices come from SD_TP_DEVICES (comma-separated ggml device names, default "CUDA0,CUDA1").
+// Weights of the FLUX-style blocks are split like llama.cpp's -sm tensor: the fused qkv, mlp-in and
+// single-block linear1 by output rows, the attention projection, mlp-out and linear2 by input
+// columns (their outputs are then partial sums that the meta backend all-reduces). Everything else
+// is mirrored on every device. Z-Image blocks are split the same way (fused qkv and w1/w3 by rows,
+// attention out and w2 by columns).
+static bool is_tp_backend_token(const std::string& name) {
+    return lower_copy(trim_copy(name)) == "tp";
+}
+
+static size_t sd_tp_n_devices = 0;
+
+static ggml_backend_meta_split_state sd_tp_get_split_state(const ggml_tensor* tensor, void* userdata) {
+    (void)userdata;
+    static const std::regex re_qkv_w("(^|\\.)(img|txt)_attn\\.qkv\\.weight$");
+    static const std::regex re_qkv_b("(^|\\.)(img|txt)_attn\\.qkv\\.bias$");
+    static const std::regex re_proj_w("(^|\\.)(img|txt)_attn\\.proj\\.weight$");
+    static const std::regex re_mlp_in_w("(^|\\.)(img|txt)_mlp\\.0\\.weight$");
+    static const std::regex re_mlp_in_b("(^|\\.)(img|txt)_mlp\\.0\\.bias$");
+    static const std::regex re_mlp_out_w("(^|\\.)(img|txt)_mlp\\.2\\.weight$");
+    static const std::regex re_lin1_w("(^|\\.)single_blocks\\.\\d+\\.linear1\\.weight$");
+    static const std::regex re_lin1_b("(^|\\.)single_blocks\\.\\d+\\.linear1\\.bias$");
+    static const std::regex re_lin2_w("(^|\\.)single_blocks\\.\\d+\\.linear2\\.weight$");
+    // Z-Image: layers / noise_refiner / context_refiner blocks with a fused qkv and a SwiGLU feed-forward
+    static const std::regex re_z_qkv_w("(^|\\.)attention\\.qkv\\.weight$");
+    static const std::regex re_z_out_w("(^|\\.)attention\\.out\\.weight$");
+    static const std::regex re_z_ff_in_w("(^|\\.)feed_forward\\.w[13]\\.weight$");
+    static const std::regex re_z_ff_out_w("(^|\\.)feed_forward\\.w2\\.weight$");
+
+    const std::string name = tensor->name;
+    const size_t n_dev     = sd_tp_n_devices;
+
+    ggml_backend_meta_split_state st;
+    memset(&st, 0, sizeof(st));
+    st.axis       = GGML_BACKEND_SPLIT_AXIS_MIRRORED;
+    st.nr[0]      = 1;
+    st.n_segments = 1;
+
+    int axis = -1;
+    std::vector<std::pair<int64_t, uint32_t>> segments;  // (size, repeats)
+    if (std::regex_search(name, re_qkv_w)) {
+        axis     = 1;
+        segments = {{tensor->ne[1] / 3, 3}};
+    } else if (std::regex_search(name, re_qkv_b)) {
+        axis     = 0;
+        segments = {{tensor->ne[0] / 3, 3}};
+    } else if (std::regex_search(name, re_z_qkv_w)) {
+        axis     = 1;
+        segments = {{tensor->ne[1] / 3, 3}};
+    } else if (std::regex_search(name, re_z_out_w) || std::regex_search(name, re_z_ff_out_w)) {
+        axis     = 0;
+        segments = {{tensor->ne[0], 1}};
+    } else if (std::regex_search(name, re_z_ff_in_w)) {
+        axis     = 1;
+        segments = {{tensor->ne[1], 1}};
+    } else if (std::regex_search(name, re_proj_w) || std::regex_search(name, re_mlp_out_w)) {
+        axis     = 0;
+        segments = {{tensor->ne[0], 1}};
+    } else if (std::regex_search(name, re_mlp_in_w)) {
+        axis     = 1;
+        segments = {{tensor->ne[1] / 2, 2}};
+    } else if (std::regex_search(name, re_mlp_in_b)) {
+        axis     = 0;
+        segments = {{tensor->ne[0] / 2, 2}};
+    } else if (std::regex_search(name, re_lin1_w)) {
+        // rows: q, k, v (hidden each), then the fused mlp gate and up halves
+        const int64_t hidden = tensor->ne[0];
+        axis                 = 1;
+        segments             = {{hidden, 3}, {(tensor->ne[1] - 3 * hidden) / 2, 2}};
+    } else if (std::regex_search(name, re_lin1_b)) {
+        // the hidden size is not visible from the bias; take it from linear2's convention (bias length = 3*hidden + 2*mlp)
+        return st;
+    } else if (std::regex_search(name, re_lin2_w)) {
+        // columns: attention output (hidden), then the mlp activation
+        const int64_t hidden = tensor->ne[1];
+        axis                 = 0;
+        segments             = {{hidden, 1}, {tensor->ne[0] - hidden, 1}};
+    }
+    if (axis < 0 || n_dev < 2) {
+        return st;
+    }
+
+    // split in whole 128-wide granules (one attention head; a multiple of every quant block size),
+    // as evenly as possible: 30 heads over 4 devices -> 8, 8, 7, 7
+    const int64_t granularity = std::lcm<int64_t>(ggml_blck_size(tensor->type), 128);
+    for (const auto& seg : segments) {
+        if (seg.first % granularity != 0 || seg.first / granularity < (int64_t)n_dev) {
+            return st;  // not whole heads, or fewer heads than devices: keep it mirrored
+        }
+    }
+    st.axis = (ggml_backend_meta_split_axis)axis;
+    for (size_t is = 0; is < segments.size(); is++) {
+        const int64_t units = segments[is].first / granularity;
+        for (size_t j = 0; j < n_dev; j++) {
+            const int64_t u      = units / (int64_t)n_dev + ((int64_t)j < units % (int64_t)n_dev ? 1 : 0);
+            st.ne[is * n_dev + j] = u * granularity;
+        }
+        st.nr[is] = segments[is].second;
+    }
+    st.n_segments = (uint32_t)segments.size();
+    return st;
+}
+
+static ggml_backend_dev_t sd_tp_meta_device() {
+    static ggml_backend_dev_t meta_dev = nullptr;
+    static std::mutex mtx;
+    std::lock_guard<std::mutex> lock(mtx);
+    if (meta_dev != nullptr) {
+        return meta_dev;
+    }
+    const char* env  = std::getenv("SD_TP_DEVICES");
+    std::string list = env != nullptr && *env ? env : "CUDA0,CUDA1";
+    std::vector<ggml_backend_dev_t> devs;
+    std::stringstream ss(list);
+    std::string item;
+    while (std::getline(ss, item, ',')) {
+        item = trim_copy(item);
+        if (item.empty()) {
+            continue;
+        }
+        ggml_backend_dev_t dev = ggml_backend_dev_by_name(item.c_str());
+        if (dev == nullptr) {
+            LOG_ERROR("tp: device '%s' from SD_TP_DEVICES not found", item.c_str());
+            return nullptr;
+        }
+        devs.push_back(dev);
+    }
+    if (devs.size() < 2) {
+        LOG_ERROR("tp: SD_TP_DEVICES needs at least two devices, got '%s'", list.c_str());
+        return nullptr;
+    }
+    sd_tp_n_devices = devs.size();
+    meta_dev        = ggml_backend_meta_device(devs.data(), devs.size(), sd_tp_get_split_state, nullptr);
+    LOG_INFO("tp: tensor-parallel meta device over %s (%zu devices)", list.c_str(), devs.size());
+    return meta_dev;
 }
 
