diff --git a/src/ggml-backend-meta.cpp b/src/ggml-backend-meta.cpp
index fb447e97..5bdacb82 100644
--- a/src/ggml-backend-meta.cpp
+++ b/src/ggml-backend-meta.cpp
@@ -541,6 +541,18 @@ static struct ggml_backend_meta_split_state ggml_backend_meta_get_split_state(
         if (scalar_only && ret.axis >= 0 && ret.axis < GGML_MAX_DIMS) {
             ret = {GGML_BACKEND_SPLIT_AXIS_UNKNOWN, {0}, {1}, 1};
         }
+        if (ret.axis == GGML_BACKEND_SPLIT_AXIS_UNKNOWN) {
+            GGML_LOG_ERROR("meta: no common split state for %s '%s' [%lld,%lld,%lld,%lld] (scalar_only=%d)\n", ggml_op_name(tensor->op), tensor->name,
+                (long long) tensor->ne[0], (long long) tensor->ne[1], (long long) tensor->ne[2], (long long) tensor->ne[3], (int) scalar_only);
+            for (size_t i = 0; i < GGML_MAX_SRC; i++) {
+                if (tensor->src[i] == nullptr) {
+                    continue;
+                }
+                GGML_LOG_ERROR("meta:   src%zu %s '%s' [%lld,%lld,%lld,%lld] axis=%s n_seg=%u ne0=%lld,%lld\n", i, ggml_op_name(tensor->src[i]->op), tensor->src[i]->name,
+                    (long long) tensor->src[i]->ne[0], (long long) tensor->src[i]->ne[1], (long long) tensor->src[i]->ne[2], (long long) tensor->src[i]->ne[3],
+                    ggml_backend_meta_split_axis_name(src_ss[i].axis), src_ss[i].n_segments, (long long) src_ss[i].ne[0], (long long) src_ss[i].ne[1]);
+            }
+        }
         GGML_ASSERT(ret.axis != GGML_BACKEND_SPLIT_AXIS_UNKNOWN);
         return ret;
     };
@@ -578,6 +590,19 @@ static struct ggml_backend_meta_split_state ggml_backend_meta_get_split_state(
         if (src_ss[0].axis == src_ss[1].axis && src_ss[0].axis != concat_axis) {
             return src_ss[0];
         }
+        if (src_ss[0].axis == concat_axis && src_ss[1].axis == concat_axis) {
+            // both inputs split along the concat axis: each device concatenates its own slices,
+            // so its share of the result is the sum of its shares of the inputs
+            ggml_backend_meta_split_state ret = {concat_axis, {0}, {1}, 1};
+            for (size_t j = 0; j < n_bufs; j++) {
+                for (int i = 0; i < 2; i++) {
+                    for (size_t s = 0; s < src_ss[i].n_segments; s++) {
+                        ret.ne[j] += src_ss[i].ne[s*n_bufs + j] * src_ss[i].nr[s];
+                    }
+                }
+            }
+            return ret;
+        }
         return handle_generic(src_ss, /*scalar_only =*/ true);
     };
 
@@ -982,6 +1007,20 @@ static struct ggml_backend_meta_split_state ggml_backend_meta_get_split_state(
             case GGML_OP_ROPE_BACK: {
                 split_state = handle_rope(src_ss);
             } break;
+            case GGML_OP_ROPE_APPLY: {
+                // [d, n_head, n_tok, N] -> [d, n_tok, n_head*N]: a split over heads (axis 1) moves to axis 2,
+                // a split over tokens (axis 2) moves to axis 1; the precomputed pe is indexed by token and mirrored
+                GGML_ASSERT(src_ss[1].axis == GGML_BACKEND_SPLIT_AXIS_MIRRORED);
+                split_state = src_ss[0];
+                if (src_ss[0].axis == GGML_BACKEND_SPLIT_AXIS_1) {
+                    GGML_ASSERT(tensor->src[0]->ne[3] == 1);
+                    split_state.axis = GGML_BACKEND_SPLIT_AXIS_2;
+                } else if (src_ss[0].axis == GGML_BACKEND_SPLIT_AXIS_2) {
+                    split_state.axis = GGML_BACKEND_SPLIT_AXIS_1;
+                } else {
+                    GGML_ASSERT(src_ss[0].axis == GGML_BACKEND_SPLIT_AXIS_MIRRORED);
+                }
+            } break;
             case GGML_OP_CLAMP: {
                 split_state = handle_generic(src_ss, /*scalar_only =*/ false);
             } break;
